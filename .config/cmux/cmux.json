{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "app": {
    "appearance": "system",
    "hideTabCloseButton": true,
    "accentColor": "#8fbcbb",
    "globalFontMagnification": 120
  },

  "workspaceColors": {
    // вместо ярко-синей заливки — лёгкий тинт с тонкой полоской
    "subtleSelection": true,
    "selectionColor": "#5e8b8a",
    "indicatorStyle": "washRail"
  },

  "sidebar": {
    "pathLastSegmentOnly": true
  },

  "sidebarAppearance": {
    "matchTerminalBackground": true
  },

  "activePaneBorderColor": "#d97757"
}
